<Project Sdk="Microsoft.NET.Sdk">

  <!-- Platform-neutral core: settings, tools, safety, vault, MCP, model backends, session. Runs on Windows and Linux. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>DeskPilot.Core</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- DPAPI for API keys on Windows (SecretProtector uses a key file on other systems). -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DeskPilot.Tests" />
    <InternalsVisibleTo Include="DeskPilot.Linux.Tests" />
    <InternalsVisibleTo Include="DeskPilot" />
    <InternalsVisibleTo Include="DeskPilot.Desktop.Windows" />
    <InternalsVisibleTo Include="DeskPilot.Desktop.Linux" />
  </ItemGroup>

</Project>
