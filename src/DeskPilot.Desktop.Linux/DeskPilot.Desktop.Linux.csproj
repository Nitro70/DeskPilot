<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Linux desktop layer: X11 (native Xlib/XTest) and Wayland (portals and compositor tools), AT-SPI, launcher, clipboard, shell. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>DeskPilot.Desktop.Linux</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- Same versions Avalonia 12.1.3 uses, so the app resolves one copy of each. -->
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="3.119.4" />
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.94.1" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DeskPilot.Linux.Tests" />
    <InternalsVisibleTo Include="deskpilot" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DeskPilot.Core\DeskPilot.Core.csproj" />
  </ItemGroup>

</Project>
