<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DeskPilot.Linux.ViewModels"
        x:Class="DeskPilot.Linux.Views.OverlayWindow"
        x:DataType="vm:OverlayViewModel"
        Title="DeskPilot status"
        Icon="avares://deskpilot/Assets/DeskPilot.png"
        Width="400" SizeToContent="Height"
        WindowDecorations="None" CanResize="False"
        Topmost="True" ShowActivated="False" ShowInTaskbar="False" Focusable="False"
        WindowStartupLocation="Manual"
        TransparencyLevelHint="Transparent"
        Background="Transparent" Foreground="{DynamicResource TextBrush}">
    <Window.Styles>
        <Style Selector="Path.spinner">
            <Style.Animations>
                <Animation Duration="0:0:0.9" IterationCount="Infinite">
                    <KeyFrame Cue="0%">
                        <Setter Property="RotateTransform.Angle" Value="0" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="RotateTransform.Angle" Value="360" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </Window.Styles>

    <Border x:Name="Card" Margin="10" Padding="14,11" CornerRadius="14"
            Background="{DynamicResource CardBrush}"
            BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1"
            BoxShadow="0 4 18 0 #80000000">
        <Grid ColumnDefinitions="Auto,*,Auto">
            <!-- Spinner: a quarter arc rotating over a faint ring. -->
            <Grid Width="22" Height="22" Margin="0,0,12,0" VerticalAlignment="Center">
                <Ellipse Stroke="{DynamicResource BorderStrongBrush}" StrokeThickness="3" />
                <Path x:Name="Arc" Classes="spinner" Stroke="{DynamicResource AccentBrush}" StrokeThickness="3"
                      StrokeLineCap="Round" Data="M 11,1.5 A 9.5,9.5 0 0 1 20.5,11" RenderTransformOrigin="50%,50%">
                    <Path.RenderTransform>
                        <RotateTransform Angle="0" />
                    </Path.RenderTransform>
                </Path>
            </Grid>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" />
                    <Border Classes="badge" Margin="8,0,0,0" Background="{DynamicResource WarningSoftBrush}"
                            IsVisible="{Binding DryRun}">
                        <TextBlock Text="DRY RUN" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}" />
                    </Border>
                </StackPanel>
                <TextBlock Text="{Binding Detail}" Margin="0,2,0,0" FontSize="12"
                           Foreground="{DynamicResource SubtleTextBrush}" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding FooterText}" Margin="0,2,0,0" FontSize="11"
                           Foreground="{DynamicResource MutedTextBrush}" TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <!-- ClickMode=Press: the window is never activated, so act on the first press. -->
            <Button x:Name="StopButton" Grid.Column="2" Margin="12,0,0,0" Padding="14,4" MinHeight="30" VerticalAlignment="Center"
                    Classes="danger" Content="Stop" ClickMode="Press" Focusable="False"
                    Command="{Binding StopCommand}"
                    ToolTip.Tip="Stop DeskPilot" AutomationProperties.Name="Stop DeskPilot" />
        </Grid>
    </Border>
</Window>
