<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DeskPilot.Linux.Views.ImageViewerWindow"
        Title="DeskPilot: screenshot"
        Icon="avares://deskpilot/Assets/DeskPilot.png"
        Width="1040" Height="720" MinWidth="360" MinHeight="260"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}">
    <Grid RowDefinitions="*,Auto">
        <ScrollViewer x:Name="Scroller" Focusable="False"
                      HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled">
            <Image x:Name="Picture" Stretch="Uniform" StretchDirection="DownOnly" Margin="12"
                   RenderOptions.BitmapInterpolationMode="HighQuality" Cursor="Hand"
                   AutomationProperties.Name="Screenshot" />
        </ScrollViewer>

        <Border Grid.Row="1" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0" Padding="14,8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
                    <Button x:Name="ZoomButton" Content="Actual size" MinWidth="100" Click="OnToggleZoom"
                            ToolTip.Tip="Switch between fit to window and 100% (Space)" />
                    <Button x:Name="CloseButton" Content="Close" MinWidth="80" IsCancel="True" Click="OnClose"
                            ToolTip.Tip="Close (Esc)" />
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="CaptionText" FontSize="13" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="SizeText" FontSize="11.5" Foreground="{DynamicResource MutedTextBrush}" Margin="0,2,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
