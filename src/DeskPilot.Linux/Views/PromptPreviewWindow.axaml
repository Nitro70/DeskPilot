<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DeskPilot.Linux.Views.PromptPreviewWindow"
        Title="System prompt preview" Width="860" Height="660" MinWidth="480" MinHeight="320"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}">
    <Grid Margin="20,16,20,16" RowDefinitions="Auto,*,Auto">
        <StackPanel>
            <TextBlock Text="System prompt preview" Classes="section-header" />
            <TextBlock x:Name="InfoText" Classes="caption" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{DynamicResource SubtleTextBrush}" />
        </StackPanel>

        <TextBox x:Name="PromptText" Grid.Row="1" Classes="mono" IsReadOnly="True" AcceptsReturn="True"
                 TextWrapping="Wrap" Margin="0,12,0,12" AutomationProperties.Name="System prompt" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button x:Name="CopyButton" Content="Copy" Click="Copy_Click" Classes="ghost" MinWidth="90" />
            <Button Content="Close" Click="Close_Click" Classes="accent" MinWidth="90" />
        </StackPanel>
    </Grid>
</Window>
