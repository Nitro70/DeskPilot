<Window x:Class="DeskPilot.Views.PromptPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="System prompt preview" Height="660" Width="860" MinWidth="480" MinHeight="320"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}">
    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="System prompt preview" Style="{DynamicResource SectionHeader}" />
            <TextBlock x:Name="InfoText" Style="{DynamicResource CaptionText}" TextWrapping="Wrap" Margin="0,4,0,0" />
        </StackPanel>

        <TextBox x:Name="PromptText" Grid.Row="1" Style="{DynamicResource MonoTextBox}" IsReadOnly="True" AcceptsReturn="True"
                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,12,0,12" AutomationProperties.Name="System prompt" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CopyButton" Content="Copy" Click="Copy_Click" Style="{DynamicResource GhostButton}" MinWidth="90" Margin="0,0,8,0" />
            <Button Content="Close" Click="Close_Click" Style="{DynamicResource AccentButton}" MinWidth="90" />
        </StackPanel>
    </Grid>
</Window>
