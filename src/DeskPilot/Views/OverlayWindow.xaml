<Window x:Class="DeskPilot.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:DeskPilot.Converters"
        Title="DeskPilot status"
        Width="400" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" Topmost="True" ShowActivated="False" ShowInTaskbar="False"
        Focusable="False" UseLayoutRounding="True"
        Left="0" Top="0"
        Foreground="{DynamicResource TextBrush}">
    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Border Margin="10" Padding="14,11" CornerRadius="14"
            Background="{DynamicResource CardBrush}"
            BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.5" Color="Black" />
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Spinner: a quarter arc rotating over a faint ring. -->
            <Grid Width="22" Height="22" Margin="0,0,12,0" VerticalAlignment="Center">
                <Ellipse Stroke="{DynamicResource BorderStrongBrush}" StrokeThickness="3" />
                <Path Stroke="{DynamicResource AccentBrush}" StrokeThickness="3"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Data="M 11,1.5 A 9.5,9.5 0 0 1 20.5,11" RenderTransformOrigin="0.5,0.5">
                    <Path.RenderTransform>
                        <RotateTransform x:Name="ArcRotation" Angle="0" />
                    </Path.RenderTransform>
                </Path>
            </Grid>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" />
                    <Border Style="{StaticResource BadgeBorder}" Margin="8,0,0,0" Background="{DynamicResource WarningSoftBrush}"
                            Visibility="{Binding DryRun, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="DRY RUN" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}" />
                    </Border>
                </StackPanel>
                <TextBlock Text="{Binding Detail}" Margin="0,2,0,0" FontSize="12"
                           Foreground="{DynamicResource SubtleTextBrush}" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding FooterText}" Margin="0,2,0,0" FontSize="11"
                           Foreground="{DynamicResource MutedTextBrush}" TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <!-- ClickMode=Press: the window never activates, so act on the first mouse-down. -->
            <Button Grid.Column="2" Margin="12,0,0,0" Padding="14,4" MinHeight="30" VerticalAlignment="Center"
                    Style="{StaticResource DangerButton}" Content="Stop" ClickMode="Press" Focusable="False"
                    Command="{Binding StopCommand}"
                    ToolTip="Stop DeskPilot" AutomationProperties.Name="Stop DeskPilot" />
        </Grid>
    </Border>
</Window>
