<Window x:Class="DeskPilot.Views.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DeskPilot.ViewModels"
        Title="Welcome to DeskPilot" Height="720" Width="780" MinWidth="520" MinHeight="460"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}">
    <Window.Resources>
        <vm:SettingsBoolToVisibilityConverter x:Key="BoolVis" />
        <vm:SettingsTextToVisibilityConverter x:Key="TextVis" />

        <Style x:Key="Body" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="LineHeight" Value="20" />
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="ErrorLine" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="32,28,32,20">
                <TextBlock Text="Welcome to DeskPilot" FontSize="26" FontWeight="SemiBold" />
                <TextBlock Style="{StaticResource Body}" FontSize="14" Margin="0,10,0,0"
                           Text="DeskPilot lets an AI model use your PC for you. Tell it what you want done: it looks at the screen, then clicks, types and opens apps the way you would, while you watch. You can stop it at any moment." />

                <!-- Default model -->
                <Border Style="{DynamicResource CardBorder}" Margin="0,22,0,0" Padding="18">
                    <StackPanel>
                        <TextBlock Text="Your model" Style="{StaticResource CardTitle}" />
                        <TextBlock Style="{StaticResource Body}"
                                   Text="By default DeskPilot runs on your own Claude subscription through Claude Code: no API key and no extra account." />
                        <DockPanel Margin="0,14,0,0">
                            <Ellipse Width="10" Height="10" Margin="0,5,10,0" VerticalAlignment="Top">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ClaudeReady}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <StackPanel>
                                <TextBlock Text="{Binding ClaudeTitle}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding ClaudeDetail}" Style="{StaticResource Body}" />
                                <TextBox Text="{Binding ClaudeCommand, Mode=OneWay}" IsReadOnly="True" Style="{DynamicResource MonoTextBox}"
                                         HorizontalAlignment="Left" MinWidth="240" Margin="0,8,0,0" AutomationProperties.Name="Command to run"
                                         Visibility="{Binding ClaudeCommand, Converter={StaticResource TextVis}}" />
                            </StackPanel>
                        </DockPanel>
                        <TextBlock Style="{StaticResource Body}" Margin="0,14,0,0"
                                   Text="Other providers (the Anthropic API, OpenAI, Google Gemini, OpenRouter, Ollama, LM Studio and more) can be added any time in Settings, under Models &amp; providers." />
                    </StackPanel>
                </Border>

                <!-- Other detected providers -->
                <Border Style="{DynamicResource CardBorder}" Margin="0,14,0,0" Padding="18"
                        Visibility="{Binding HasOtherProviders, Converter={StaticResource BoolVis}}">
                    <StackPanel>
                        <TextBlock Text="Also found on this PC" Style="{StaticResource CardTitle}" />
                        <ItemsControl ItemsSource="{Binding OtherProviders}" Focusable="False" Margin="0,4,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,6,0,0">
                                        <Ellipse DockPanel.Dock="Left" Width="5" Height="5" Fill="{DynamicResource SubtleTextBrush}" Margin="2,7,10,0" VerticalAlignment="Top" />
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{DynamicResource SubtleTextBrush}" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Style="{StaticResource Body}" Margin="0,10,0,0" Text="Settings, Models &amp; providers, has an Add button for each of these." />
                    </StackPanel>
                </Border>

                <!-- Vault -->
                <Border Style="{DynamicResource CardBorder}" Margin="0,14,0,0" Padding="18">
                    <StackPanel>
                        <TextBlock Text="Notes vault (optional)" Style="{StaticResource CardTitle}" />
                        <TextBlock Style="{StaticResource Body}"
                                   Text="If you keep notes in a folder (an Obsidian vault works well), DeskPilot can search them when a request needs something written there. It never reads the whole vault, only the lines that match." />
                        <ListBox ItemsSource="{Binding VaultOptions}" SelectedItem="{Binding SelectedVault, Mode=TwoWay}" Margin="0,12,0,0"
                                 MaxHeight="200" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Vault choice">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:SettingsWelcomeVaultOption}">
                                    <StackPanel Margin="2,4">
                                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Button Content="Choose another folder..." Click="BrowseVault_Click" Style="{DynamicResource GhostButton}" HorizontalAlignment="Left" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>

                <!-- Control -->
                <Border Style="{DynamicResource CardBorder}" Margin="0,14,0,0" Padding="18">
                    <StackPanel>
                        <TextBlock Text="You stay in control" Style="{StaticResource CardTitle}" />
                        <TextBlock Style="{StaticResource Body}" Text="{Binding StopText}" />
                        <TextBlock Style="{StaticResource Body}" Text="{Binding AdminText}" />
                        <TextBlock Style="{StaticResource Body}" Text="DeskPilot's own windows are hidden from its screenshots, so the model never clicks them." />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="32,14">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Get started" Click="GetStarted_Click" Style="{DynamicResource AccentButton}" MinWidth="130" IsDefault="True" />
                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock x:Name="ErrorText" Style="{StaticResource ErrorLine}" />
                    <TextBlock Text="Everything here can be changed later in Settings." Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
