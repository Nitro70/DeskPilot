<Window x:Class="DeskPilot.Views.ImageViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeskPilot: screenshot"
        Width="1040" Height="720" MinWidth="360" MinHeight="260"
        WindowStartupLocation="CenterOwner"
        Icon="/DeskPilot;component/Assets/DeskPilot.ico"
        UseLayoutRounding="True"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer x:Name="Scroller" Focusable="False"
                      HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled">
            <Image x:Name="Picture" Stretch="Uniform" StretchDirection="DownOnly" Margin="12"
                   RenderOptions.BitmapScalingMode="HighQuality" Cursor="Hand"
                   MouseLeftButtonUp="OnPictureClicked"
                   AutomationProperties.Name="Screenshot" />
        </ScrollViewer>

        <Border Grid.Row="1" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0" Padding="14,8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="ZoomButton" Content="Actual size" Click="OnToggleZoom" MinWidth="100"
                            ToolTip="Switch between fit to window and 100% (Space)" />
                    <Button Content="Close" Margin="8,0,0,0" MinWidth="80" IsCancel="True" Click="OnClose"
                            ToolTip="Close (Esc)" />
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="CaptionText" FontSize="13" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="SizeText" FontSize="11.5" Foreground="{DynamicResource MutedTextBrush}" Margin="0,2,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
