<Window x:Class="DeskPilot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DeskPilot.ViewModels"
        xmlns:svc="clr-namespace:DeskPilot.Services"
        xmlns:conv="clr-namespace:DeskPilot.Converters"
        Title="DeskPilot"
        Width="980" Height="720" MinWidth="880" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Icon="/DeskPilot;component/Assets/DeskPilot.ico"
        UseLayoutRounding="True"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}">

    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewConversationCommand}" />
        <KeyBinding Key="OemComma" Modifiers="Control" Command="{Binding OpenSettingsCommand}" />
        <KeyBinding Key="Escape" Command="{Binding StopCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />
        <conv:EmptyToCollapsedConverter x:Key="EmptyToCollapsed" />
        <conv:EmptyToCollapsedConverter x:Key="EmptyToVisible" Invert="True" />
        <conv:AllTrueToVisibilityConverter x:Key="AllTrueToVis" />

        <BitmapImage x:Key="AppLogo" UriSource="/DeskPilot;component/Assets/DeskPilot.png" DecodePixelWidth="112" />

        <!-- Read-only, selectable text without any box around it. -->
        <Style x:Key="SelectableText" TargetType="{x:Type TextBox}">
            <Setter Property="IsReadOnly" Value="True" />
            <!-- Mouse-selectable, but not a Tab stop: keyboard focus moves between controls, not messages. -->
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="IsReadOnlyCaretVisible" Value="False" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource SelectionBrush}" />
            <Setter Property="SelectionOpacity" Value="0.45" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False" Background="Transparent"
                                      HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MarkdownText" TargetType="{x:Type RichTextBox}">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="IsReadOnlyCaretVisible" Value="False" />
            <Setter Property="IsDocumentEnabled" Value="True" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource SelectionBrush}" />
            <Setter Property="SelectionOpacity" Value="0.45" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RichTextBox}">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False" Background="Transparent"
                                      HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ComposerTextBox" TargetType="{x:Type TextBox}" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,9" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
        </Style>

        <Style x:Key="SmallGhostButton" TargetType="{x:Type Button}" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="SendButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource AccentButton}">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Content" Value="&#xE724;" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                    <Setter Property="Content" Value="&#xE71A;" />
                    <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsBusy}" Value="True" />
                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource DangerHoverBrush}" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StatusPill" TargetType="{x:Type Border}">
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Background" Value="{DynamicResource Panel2Brush}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource SubtleTextBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DisplayState}" Value="Starting">
                    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource AccentHoverBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DisplayState}" Value="Running">
                    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource AccentHoverBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DisplayState}" Value="Stopping">
                    <Setter Property="Background" Value="{DynamicResource WarningSoftBrush}" />
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource WarningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DisplayState}" Value="Error">
                    <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource DangerBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ThumbnailButton" TargetType="{x:Type Button}">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Bd" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"
                                Background="{DynamicResource InputBgBrush}" Padding="2">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================================== Log item templates -->
        <DataTemplate DataType="{x:Type vm:UserMessageItem}">
            <Grid MaxWidth="860" Margin="0,14,0,6">
                <Border HorizontalAlignment="Right" MaxWidth="640" Margin="96,0,0,0" Padding="14,9"
                        CornerRadius="14,14,4,14" Background="{DynamicResource UserBubbleBrush}"
                        BorderBrush="{DynamicResource AccentSoftBrush}" BorderThickness="1">
                    <TextBox Style="{StaticResource SelectableText}" Text="{Binding Text, Mode=OneWay}" FontSize="14"
                             AutomationProperties.Name="Your message" />
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:AssistantTextItem}">
            <Grid MaxWidth="860" Margin="0,8,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image Source="{StaticResource AppLogo}" Width="26" Height="26" Margin="0,1,12,0" VerticalAlignment="Top"
                       RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="DeskPilot" />
                <RichTextBox Grid.Column="1" Style="{StaticResource MarkdownText}"
                             svc:MarkdownView.Text="{Binding Text}"
                             AutomationProperties.Name="DeskPilot reply" />
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ThinkingItem}">
            <Grid MaxWidth="860" Margin="0,2,0,2"
                  Visibility="{Binding DataContext.ShowThinking, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}, Converter={StaticResource BoolToVis}}">
                <Expander Margin="34,0,0,0" Padding="4,3" IsExpanded="False" ToolTip="The model's reasoning">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Thinking" FontStyle="Italic" FontSize="12.5" Foreground="{DynamicResource SubtleTextBrush}" />
                            <TextBlock Text="&#x2026;" FontSize="12.5" Foreground="{DynamicResource SubtleTextBrush}"
                                       Visibility="{Binding IsStreaming, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </Expander.Header>
                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="2,0,0,0" Padding="12,2,0,2">
                        <TextBox Style="{StaticResource SelectableText}" Text="{Binding Text, Mode=OneWay}"
                                 FontSize="12.5" FontStyle="Italic" Foreground="{DynamicResource SubtleTextBrush}"
                                 AutomationProperties.Name="Thinking" />
                    </Border>
                </Expander>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ToolStepItem}">
            <Grid MaxWidth="860" Margin="0,2,0,2">
                <Border x:Name="Card" Margin="38,0,0,0" Padding="10,7" CornerRadius="8"
                        Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        ToolTip="{Binding ResultTooltip}" ToolTipService.ShowDuration="30000">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="Icon" Text="{Binding Icon}" FontFamily="{DynamicResource IconFont}" FontSize="14"
                                   Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <TextBlock Grid.Column="1" Text="{Binding Summary}" FontSize="13" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                            <TextBlock Text="running" FontSize="11.5" FontStyle="Italic" Foreground="{DynamicResource MutedTextBrush}"
                                       Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="{Binding DurationText}" FontSize="11.5" Foreground="{DynamicResource MutedTextBrush}" />
                        </StackPanel>
                        <TextBlock x:Name="ErrorText" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4,0,0"
                                   Text="{Binding ResultPreview}" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource DangerBrush}" Visibility="Collapsed" />
                        <Button Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,8,0,2" HorizontalAlignment="Left"
                                Style="{StaticResource ThumbnailButton}"
                                Command="{Binding DataContext.OpenImageCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                CommandParameter="{Binding}"
                                ToolTip="Open the screenshot" AutomationProperties.Name="Open the screenshot">
                            <Button.Visibility>
                                <MultiBinding Converter="{StaticResource AllTrueToVis}">
                                    <Binding Path="HasImage" />
                                    <Binding Path="DataContext.ShowScreenshots" RelativeSource="{RelativeSource AncestorType={x:Type ItemsControl}}" />
                                </MultiBinding>
                            </Button.Visibility>
                            <Image Source="{Binding Thumbnail}" MaxWidth="240" MaxHeight="150" Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                        </Button>
                    </Grid>
                </Border>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsError}" Value="True">
                    <Setter TargetName="Card" Property="Background" Value="{DynamicResource DangerSoftBrush}" />
                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                    <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource DangerBrush}" />
                    <Setter TargetName="ErrorText" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:StatusLineItem}">
            <Grid MaxWidth="860" Margin="0,4,0,4">
                <Grid Margin="38,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="Glyph" Text="&#xE946;" FontFamily="{DynamicResource IconFont}" FontSize="12"
                               Foreground="{DynamicResource MutedTextBrush}" Margin="0,2,8,0" VerticalAlignment="Top" />
                    <TextBox x:Name="Message" Grid.Column="1" Style="{StaticResource SelectableText}" Text="{Binding Message, Mode=OneWay}"
                             FontSize="12.5" Foreground="{DynamicResource SubtleTextBrush}" AutomationProperties.Name="Status" />
                </Grid>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Level}" Value="Warning">
                    <Setter TargetName="Glyph" Property="Text" Value="&#xE7BA;" />
                    <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource WarningBrush}" />
                    <Setter TargetName="Message" Property="Foreground" Value="{DynamicResource WarningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="Error">
                    <Setter TargetName="Glyph" Property="Text" Value="&#xEA39;" />
                    <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource DangerBrush}" />
                    <Setter TargetName="Message" Property="Foreground" Value="{DynamicResource DangerBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:TurnFooterItem}">
            <Grid MaxWidth="860" Margin="0,6,0,16">
                <StackPanel Margin="38,0,0,0">
                    <Border HorizontalAlignment="Left" CornerRadius="10" Padding="10,3" Background="{DynamicResource PanelBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="Glyph" Text="&#xE73E;" FontFamily="{DynamicResource IconFont}" FontSize="11"
                                       Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,7,0" />
                            <TextBlock Text="{Binding Text}" FontSize="11.5" Foreground="{DynamicResource SubtleTextBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <TextBox Style="{StaticResource SelectableText}" Text="{Binding Error, Mode=OneWay}" Margin="2,6,0,0"
                             FontSize="12.5" Foreground="{DynamicResource DangerBrush}"
                             Visibility="{Binding Error, Converter={StaticResource EmptyToCollapsed}}"
                             AutomationProperties.Name="Error" />
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Outcome}" Value="Cancelled">
                    <Setter TargetName="Glyph" Property="Text" Value="&#xE71A;" />
                    <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource WarningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Outcome}" Value="StepLimit">
                    <Setter TargetName="Glyph" Property="Text" Value="&#xE7BA;" />
                    <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource WarningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Outcome}" Value="Failed">
                    <Setter TargetName="Glyph" Property="Text" Value="&#xEA39;" />
                    <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource DangerBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============================================== Top bar -->
        <Border Grid.Row="0" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="130" MaxWidth="230" />
                    <ColumnDefinition Width="*" MinWidth="150" MaxWidth="270" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="0.1*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ComboBox x:Name="ProfileBox" Grid.Column="0"
                          ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" DisplayMemberPath="Name"
                          IsEnabled="{Binding IsIdle}"
                          ToolTip="Provider profile (add or edit profiles in Settings)"
                          AutomationProperties.Name="Provider profile" />

                <ComboBox x:Name="ModelBox" Grid.Column="1" Margin="8,0,0,0"
                          IsEditable="True" IsTextSearchEnabled="False" TextSearch.TextPath="Id"
                          ItemsSource="{Binding Models}" SelectedItem="{Binding SelectedModel}"
                          Text="{Binding ModelText, UpdateSourceTrigger=LostFocus}"
                          PreviewKeyDown="OnModelBoxKeyDown"
                          ToolTip="Model: pick one or type any model id the provider accepts"
                          AutomationProperties.Name="Model">
                    <ComboBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ModelOption}">
                            <StackPanel>
                                <TextBlock Text="{Binding Id}" FontSize="13" />
                                <TextBlock Text="{Binding DisplayName}" FontSize="11" Foreground="{DynamicResource SubtleTextBrush}"
                                           Visibility="{Binding HasDisplayName, Converter={StaticResource BoolToVis}}" />
                                <TextBlock Text="{Binding Hints}" FontSize="11" Foreground="{DynamicResource MutedTextBrush}"
                                           Visibility="{Binding HasHints, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <Button Grid.Column="2" Margin="2,0,0,0" Style="{StaticResource IconButton}" Content="&#xE72C;"
                        Command="{Binding RefreshModelsCommand}"
                        ToolTip="{Binding RefreshModelsTooltip}" AutomationProperties.Name="Refresh the model list" />

                <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Thinking" FontSize="12" Foreground="{DynamicResource SubtleTextBrush}"
                               VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Border Style="{StaticResource SegmentedContainer}" AutomationProperties.Name="Thinking">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource SegmentedRadio}" GroupName="ThinkingMode" Content="Auto"
                                         IsChecked="{Binding IsThinkingAuto}" ToolTip="Thinking: provider default"
                                         AutomationProperties.Name="Thinking auto" />
                            <RadioButton Style="{StaticResource SegmentedRadio}" GroupName="ThinkingMode" Content="On"
                                         IsChecked="{Binding IsThinkingOn}" ToolTip="Thinking on: slower, more careful"
                                         AutomationProperties.Name="Thinking on" />
                            <RadioButton Style="{StaticResource SegmentedRadio}" GroupName="ThinkingMode" Content="Off"
                                         IsChecked="{Binding IsThinkingOff}" ToolTip="Thinking off: fastest"
                                         AutomationProperties.Name="Thinking off" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Effort" FontSize="12" Foreground="{DynamicResource SubtleTextBrush}"
                               VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox Width="100" ItemsSource="{Binding Efforts}" SelectedItem="{Binding Effort}"
                              ToolTip="Reasoning effort for models that support it"
                              AutomationProperties.Name="Effort" />
                </StackPanel>

                <Border Grid.Column="6" Style="{StaticResource StatusPill}" VerticalAlignment="Center" Margin="12,0,0,0"
                        AutomationProperties.Name="{Binding StatusText}" ToolTip="Agent status">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                                 Fill="{Binding (TextElement.Foreground), RelativeSource={RelativeSource AncestorType={x:Type Border}}}" />
                        <TextBlock Text="{Binding StatusText}" FontSize="12" FontWeight="SemiBold" Margin="7,0,0,0" />
                    </StackPanel>
                </Border>

                <Button Grid.Column="7" Margin="8,0,0,0" Style="{StaticResource IconButton}" Content="&#xE713;"
                        Command="{Binding OpenSettingsCommand}"
                        ToolTip="Settings (Ctrl+,)" AutomationProperties.Name="Settings" />
            </Grid>
        </Border>

        <!-- ============================================== Conversation -->
        <Grid Grid.Row="1">
            <ItemsControl x:Name="LogList" ItemsSource="{Binding Items}" Focusable="False" Padding="24,10,24,10"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Standard"
                          VirtualizingPanel.ScrollUnit="Pixel"
                          ScrollViewer.CanContentScroll="True"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          PreviewMouseWheel="OnLogPreviewMouseWheel"
                          AutomationProperties.Name="Conversation">
                <ItemsControl.Template>
                    <ControlTemplate TargetType="{x:Type ItemsControl}">
                        <ScrollViewer x:Name="PART_LogScroll" Padding="{TemplateBinding Padding}" Focusable="False">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </ControlTemplate>
                </ItemsControl.Template>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="540" Margin="24"
                        Visibility="{Binding HasItems, Converter={StaticResource InverseBoolToVis}}">
                <Image Source="{StaticResource AppLogo}" Width="56" Height="56" RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Text="What should DeskPilot do?" FontSize="21" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Margin="0,16,0,6" />
                <TextBlock Style="{StaticResource CaptionText}" FontSize="13" TextAlignment="Center"
                           Text="Describe a task in plain words. DeskPilot looks at your screen and uses the mouse and keyboard to do it. You can take back control at any time." />
                <TextBlock Text="{Binding StopHotkeyText}" FontSize="12" HorizontalAlignment="Center" Margin="0,8,0,0"
                           Foreground="{DynamicResource AccentHoverBrush}" />
                <ItemsControl ItemsSource="{Binding Examples}" Margin="0,20,0,0" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding}" Margin="0,4" HorizontalContentAlignment="Left" Padding="14,8"
                                    Background="{DynamicResource PanelBrush}"
                                    Command="{Binding DataContext.UseExampleCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                    CommandParameter="{Binding}"
                                    ToolTip="Put this example in the message box" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <Button x:Name="JumpToLatest" Style="{StaticResource AccentButton}" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                    Margin="0,0,0,12" Padding="12,4" MinHeight="28" Visibility="Collapsed" Click="OnJumpToLatest"
                    ToolTip="Scroll to the newest messages" AutomationProperties.Name="Jump to latest">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE74B;" FontFamily="{StaticResource IconFont}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="Jump to latest" FontSize="12" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- ============================================== Composer -->
        <Border Grid.Row="2" Padding="24,4,24,12">
            <Border x:Name="Composer" MaxWidth="900" CornerRadius="12" Padding="6,6,6,4" BorderThickness="1"
                    Background="{DynamicResource CardBrush}">
                <Border.Style>
                    <Style TargetType="{x:Type Border}">
                        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                        <Style.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBox x:Name="InputBox" Style="{StaticResource ComposerTextBox}"
                             Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="44" MaxHeight="190"
                             VerticalScrollBarVisibility="Auto" SpellCheck.IsEnabled="True"
                             PreviewKeyDown="OnInputPreviewKeyDown"
                             AutomationProperties.Name="Message to DeskPilot"
                             AutomationProperties.HelpText="Enter sends, Shift+Enter adds a new line" />
                    <TextBlock Text="Tell DeskPilot what to do..." IsHitTestVisible="False" Margin="11,10,0,0" FontSize="14"
                               Foreground="{DynamicResource MutedTextBrush}"
                               Visibility="{Binding InputText, Converter={StaticResource EmptyToVisible}}" />

                    <Button x:Name="SendButton" Grid.Column="1" Width="40" Height="40" MinHeight="0" Margin="6,2,2,2"
                            VerticalAlignment="Bottom" Style="{StaticResource SendButtonStyle}"
                            Command="{Binding SendOrStopCommand}"
                            ToolTip="{Binding SendButtonTooltip}"
                            AutomationProperties.Name="{Binding SendButtonText}" />

                    <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="2,2,4,0">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource SmallGhostButton}" Command="{Binding NewConversationCommand}"
                                    ToolTip="Forget this conversation and start fresh (Ctrl+N)"
                                    AutomationProperties.Name="New conversation">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Text="New conversation" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SmallGhostButton}" Command="{Binding CopyLogCommand}" Margin="4,0,0,0"
                                    ToolTip="Copy the whole conversation as text" AutomationProperties.Name="Copy log">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8C8;" FontFamily="{StaticResource IconFont}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock x:Name="CopyLabel" Text="Copy log" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11.5"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Text="Enter to send, Shift+Enter for a new line" />
                    </Grid>
                </Grid>
            </Border>
        </Border>

        <!-- ============================================== Status bar -->
        <Border Grid.Row="3" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0" Padding="14,5">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" ToolTip="{Binding HotkeyTooltip}">
                    <TextBlock Text="&#xE765;" FontFamily="{StaticResource IconFont}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HotkeyOk}" Value="False">
                                        <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding StopHotkeyText}" FontSize="12" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HotkeyOk}" Value="False">
                                        <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                        <Setter Property="TextDecorations" Value="Strikethrough" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding ProfileModelText}" FontSize="12" Foreground="{DynamicResource SubtleTextBrush}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="420"
                               ToolTip="Active profile and model" />
                    <TextBlock Text="&#x00B7;" Margin="10,0" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding VaultText}" FontSize="12" VerticalAlignment="Center" ToolTip="{Binding VaultTooltip}">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding VaultOn}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Border Style="{StaticResource BadgeBorder}" Margin="10,0,0,0" Background="{DynamicResource WarningSoftBrush}"
                            Visibility="{Binding AdminMode, Converter={StaticResource BoolToVis}}"
                            ToolTip="Administrator mode is on: the agent may work with elevated windows">
                        <TextBlock Text="ADMIN MODE" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}" />
                    </Border>
                    <Border Style="{StaticResource BadgeBorder}" Margin="8,0,0,0" Background="{DynamicResource AccentSoftBrush}"
                            Visibility="{Binding DryRun, Converter={StaticResource BoolToVis}}"
                            ToolTip="Dry run: actions are described but the mouse and keyboard are not used">
                        <TextBlock Text="DRY RUN" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AccentHoverBrush}" />
                    </Border>
                    <TextBlock x:Name="TransientNote" Margin="12,0,0,0" FontSize="12" VerticalAlignment="Center"
                               Foreground="{DynamicResource SuccessBrush}" Visibility="Collapsed" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
