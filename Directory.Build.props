<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>1.0.0</Version>
    <Product>DeskPilot</Product>
    <Company>DeskPilot contributors</Company>
    <Copyright>Copyright (c) DeskPilot contributors</Copyright>
    <Authors>DeskPilot contributors</Authors>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <!-- Map build-machine paths to /_/ so no local paths end up in published binaries. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <Deterministic>true</Deterministic>
    <!-- Symbols live inside the assemblies, so a publish is just DeskPilot.exe. -->
    <DebugType>embedded</DebugType>
  </PropertyGroup>
</Project>
